# 使用 npm run init 生成实际 .env 和 .secrets；不要直接用此模板启动。
PUBLIC_URL=http://127.0.0.1:3000
APP_PORT=3000
PORT=3000
HOST=127.0.0.1
# 初始化命令生成 POSTGRES_PASSWORD、QDRANT_API_KEY、OWNER_PASSWORD_HASH、OAUTH_COOKIE_KEY。
# 本机直接运行时另外设置 DATABASE_URL、QDRANT_URL；Compose 内自动配置。
OAUTH_ENABLED=true
OAUTH_JWKS_PATH=./.secrets/jwks.json
OAUTH_CLIENTS_JSON=[]
# NPM 网络部署时设置可信代理网段，逗号分隔，不能设为 true 或任意公网。
TRUST_PROXY=
ALLOWED_ORIGINS=
# 仅显式允许私网 IPv4 HTTP，且必须 OAUTH_ENABLED=false；公网入口使用 HTTPS。
ALLOW_INSECURE_LAN_HTTP=false
# 用户已选 EmbeddingGemma 2 文本版，采用实测 Q4 / 768 维。
# 如显式清空模型，保留事实读写与关键词检索，普通向量任务等待。
EMBEDDING_MODEL=gemma2
EMBEDDING_DTYPE=q4
MODEL_CACHE=./.cache/models
EXTERNAL_ORGANIZE_ENABLED=false
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=
LLM_API_KEY=
