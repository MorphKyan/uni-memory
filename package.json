{
  "name": "uni-memory",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "node scripts/check-web.cjs -p web/tsconfig.json && vite build web --config web/vite.config.ts",
    "dev:web": "vite web --config web/vite.config.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/migrate.js",
    "init": "node scripts/init.mjs",
    "cli": "node dist/src/cli.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test:integration": "node --test --test-concurrency=1 dist/test/*.integration.js",
    "memory:install": "node scripts/install-memory-policy.mjs",
    "plugin:build:agent": "node scripts/build-agent-plugin.mjs",
    "plugin:build": "node scripts/build-chatgpt-plugin.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "oidc-provider": "9.13.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "7.0.2",
    "typescript-vue": "npm:typescript@6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14",
    "vue": "3.5.44"
  }
}
